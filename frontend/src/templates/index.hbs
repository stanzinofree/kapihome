<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/theme.css">
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/header.css">
    <link rel="stylesheet" href="/static/css/mini-cards.css">
    <link rel="stylesheet" href="/static/css/linkedin-card.css">
    <link rel="stylesheet" href="/static/css/profile-card.css">
    <link rel="stylesheet" href="/static/css/exercism-card.css">
    <link rel="stylesheet" href="/static/css/github-card.css">
    <link rel="stylesheet" href="/static/css/cal-card.css">
    <link rel="stylesheet" href="/static/css/udemy-card.css">
    <link rel="stylesheet" href="/static/css/rtm-card.css">
    <link rel="stylesheet" href="/static/css/welltory-card.css">
    <script src="/static/js/theme-toggle.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
<body>
    <!-- Header Navigation -->
    <header class="header">
        <nav class="nav-container">
            <a href="/" class="logo">KapiHome</a>
            
            <ul class="nav-links">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="/linkedin">LinkedIn</a></li>
                <li><a href="/github">GitHub</a></li>
                <li><a href="/exercism">Exercism</a></li>
                <li><a href="/rtm">Tasks</a></li>
                <li><a href="/monitoring">Monitoring</a></li>
            </ul>
            
            <div class="nav-external">
                <a href="https://cv.middei.info" target="_blank" rel="noopener">
                    📄 CV
                </a>
                <a href="https://www.linkedin.com/in/stanzinofree/" target="_blank" rel="noopener">
                    💼 LinkedIn
                </a>
            </div>
            
            <button class="mobile-menu-toggle" aria-label="Toggle menu">☰</button>
        </nav>
    </header>

    <div class="container">
        <main class="content">
            <!-- Profile Row - Full Width (12/12) -->
            <div class="profile-card card-accent-primary profile-row" hx-get="/api/profile" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading profile</div>
            </div>
            
            <!-- Masonry Grid Cards (1/3 width each) -->
            <!-- LinkedIn Mini Stats -->
            <div class="linkedin-card card-accent-linkedin" hx-get="/api/linkedin/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading LinkedIn stats</div>
            </div>
            
            <!-- Exercism Mini Stats -->
            <div class="exercism-card card-accent-exercism" hx-get="/api/exercism/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading Exercism stats</div>
            </div>
            
            <!-- GitHub Mini Stats -->
            <div class="github-card card-accent-github" hx-get="/api/github/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading GitHub stats</div>
            </div>
            
            <!-- Udemy Instructor Card -->
            <div class="udemy-card card-accent-udemy" hx-get="/api/udemy/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading Udemy</div>
            </div>
            
            <!-- Remember The Milk Tasks Card -->
            <div class="rtm-card card-accent-rtm" hx-get="/api/rtm/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading Tasks</div>
            </div>
            
            <!-- Welltory Health Card -->
            <div class="welltory-card card-accent-welltory" hx-get="/api/welltory/mini" hx-trigger="load" hx-swap="innerHTML">
                <div class="loading">Loading Health Data</div>
            </div>
        </main>
    </div>
    <script src="/static/js/main.js"></script>
</body>
</html>
